{
  "extends": "ts-config-single-spa",
  "include": ["src/**/*"],
  "compilerOptions": {
    "strict": true,
    "jsx": "react",
    "target": "es2016",
    "baseUrl": "src",
    "esModuleInterop": true,
    "types": ["jest", "@testing-library/jest-dom"],
    "paths": {
      "react-router/node_modules/@types/react": ["../node_modules/@types/react"]
    }
  }
}
