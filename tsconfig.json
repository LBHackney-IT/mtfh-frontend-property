{
  "extends": "ts-config-single-spa",
  "include": ["src/**/*", "*.js"],
  "compilerOptions": {
    "strict": true,
    "jsx": "react",
    "target": "es2016",
    "baseUrl": "src",
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "allowJs": true,
    "types": ["node", "jest", "@testing-library/jest-dom"]
  }
}
